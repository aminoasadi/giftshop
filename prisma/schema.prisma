generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum WalletTransactionType {
  RECHARGE_CODE
  ADMIN_INCREASE
  ADMIN_DECREASE
  PRODUCT_PURCHASE
  ORDER_REFUND
}

enum RechargeCodeStatus {
  ACTIVE
  USED
  EXPIRED
  DISABLED
}

enum OrderStatus {
  PENDING_REVIEW
  PREPARING
  HANDED_TO_COURIER
  DELIVERED
  CANCELED
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role            @default(USER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  accounts      Account[]
  sessions      Session[]
  wallet        Wallet?
  addresses     Address[]
  transactions  WalletTransaction[]
  rechargeCodes RechargeCode[]  @relation("CodeRedeemer")
  attempts      RechargeAttempt[]
  orders        Order[]
  auditLogs     AdminAuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailOtp {
  id        String    @id @default(cuid())
  email     String
  tokenHash String
  expiresAt DateTime
  attempts  Int       @default(0)
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  fullName    String
  phone       String
  postalCode  String
  line        String
  notes       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  orders      Order[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
}

model Product {
  id             String         @id @default(cuid())
  categoryId     String
  name           String
  slug           String         @unique
  description    String
  priceCredits   Int
  stock          Int
  isActive       Boolean        @default(true)
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  category       Category       @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  orderItems     OrderItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id])
}

model Wallet {
  id           String   @id @default(cuid())
  userId       String   @unique
  balance      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model WalletTransaction {
  id             String                @id @default(cuid())
  userId         String
  amount         Int
  balanceAfter   Int
  type           WalletTransactionType
  reason         String?
  rechargeCodeId String?               @unique
  orderId        String?
  createdAt      DateTime              @default(now())
  user           User                  @relation(fields: [userId], references: [id])
  rechargeCode   RechargeCode?         @relation(fields: [rechargeCodeId], references: [id])
  order          Order?                @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
}

model RechargeCode {
  id            String              @id @default(cuid())
  code          String              @unique
  valueCredits  Int
  status        RechargeCodeStatus  @default(ACTIVE)
  expiresAt     DateTime?
  usedByUserId  String?
  usedAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  usedBy        User?               @relation("CodeRedeemer", fields: [usedByUserId], references: [id])
  transaction   WalletTransaction?
}

model RechargeAttempt {
  id        String   @id @default(cuid())
  userId    String?
  ip        String?
  code      String
  success   Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([ip, createdAt])
}

model Order {
  id              String              @id @default(cuid())
  userId          String
  addressId       String?
  status          OrderStatus         @default(PENDING_REVIEW)
  totalCredits    Int
  refundedAt      DateTime?
  cancelReason    String?
  courierNotes    String?
  receiverName    String
  receiverPhone   String
  receiverAddress String
  postalCode      String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id])
  address         Address?            @relation(fields: [addressId], references: [id])
  items           OrderItem[]
  transactions    WalletTransaction[]

  @@index([userId, createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  quantity     Int
  priceCredits Int
  order        Order   @relation(fields: [orderId], references: [id])
  product      Product @relation(fields: [productId], references: [id])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  target    String
  metadata  Json?
  createdAt DateTime @default(now())
  admin     User?    @relation(fields: [adminId], references: [id])
}
